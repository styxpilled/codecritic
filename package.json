{
	"name": "codecritic2",
	"version": "2.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"cf:preview": "pnpm run build && wrangler dev",
		"cf:migrate": "wrangler d1 migrations apply codecritic-d1",
		"cf:migrate-remote": "wrangler d1 migrations apply codecritic-d1 --remote",
		"cf:deploy": "pnpm run build && wrangler deploy",
		"cf:typegen": "wrangler types && mv worker-configuration.d.ts src/"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"arctic": "^3.7.0",
		"dompurify": "^3.4.12",
		"highlight.js": "^11.11.1",
		"isomorphic-dompurify": "^3.19.0",
		"linkedom": "^0.18.13",
		"marked": "^18.0.7",
		"marked-base-url": "^1.1.10",
		"marked-highlight": "^2.2.4",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"git-describe": "^4.1.1",
		"globals": "^17.7.0",
		"lucide-static": "^1.27.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vite-plugin-lucide-sprite": "^1.0.7",
		"wrangler": "^4.114.0"
	}
}
