{
	"name": "codecritic2",
	"private": true,
	"version": "2.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:make-migrations": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"cf:preview": "pnpm run build && wrangler dev",
		"cf:migrate": "wrangler d1 migrations apply codecritic-d1",
		"cf:migrate-remote": "wrangler d1 migrations apply codecritic-d1 --remote",
		"cf:deploy": "pnpm run build && wrangler deploy",
		"cf:typegen": "wrangler types && mv worker-configuration.d.ts src/"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@libsql/client": "^0.17.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^22",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"git-describe": "^4.1.1",
		"globals": "^17.4.0",
		"lucide-static": "^1.7.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^7.3.1",
		"vite-plugin-lucide-sprite": "^1.0.7",
		"wrangler": "^4.78.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"arctic": "^3.7.0",
		"dompurify": "^3.3.3",
		"highlight.js": "^11.11.1",
		"isomorphic-dompurify": "^3.7.1",
		"linkedom": "^0.18.12",
		"marked": "^17.0.5",
		"marked-base-url": "^1.1.8",
		"marked-highlight": "^2.2.3",
		"valibot": "^1.3.1"
	}
}
