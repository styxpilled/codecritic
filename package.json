{
	"name": "codecritic",
	"version": "2.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:seed": "node scripts/seed.js",
		"db:seed:sql": "node scripts/seed.js --sql",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"cf:preview": "pnpm run build && wrangler dev --env staging",
		"cf:migrate": "wrangler d1 migrations apply codecritic-d1",
		"cf:migrate-remote": "wrangler d1 migrations apply codecritic-d1 --remote",
		"cf:seed-remote": "pnpm run db:seed:sql && wrangler d1 execute codecritic-d1 --remote --file=scripts/seed.sql",
		"cf:deploy": "pnpm run build && wrangler deploy --env prod",
		"cf:typegen": "wrangler types && mv worker-configuration.d.ts src/"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"arctic": "^3.7.0",
		"marked": "^18.1.3",
		"marked-base-url": "^1.1.10",
		"minidenticons": "^4.2.1",
		"sanitize-html": "^2.18.1",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.6.6",
		"@types/sanitize-html": "^2.16.2",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"git-describe": "^4.1.1",
		"globals": "^17.14.0",
		"lucide-static": "^1.70.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vite-plugin-lucide-sprite": "^1.0.7",
		"wrangler": "^4.158.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#ui/*": "./src/lib/ui/*",
		"#styles/*": "./src/lib/styles/*",
		"#api/*": "./src/routes/api/*"
	}
}
